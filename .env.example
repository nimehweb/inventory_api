# Copy this file to `.env` and adjust as needed:
#
#     cp .env.example .env
#     set -a; source .env; set +a
#
# Every variable is optional. If a variable is missing (or left commented out),
# core/settings.py falls back to its built-in default.
#
# Note: an exported variable that is set to an empty string is NOT treated as
# "missing". Leave DB_USER commented out to use the current system user ($USER).

# --- Database -------------------------------------------------------------
DB_NAME=inventory_db
# DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
# An empty password is normal for a local Homebrew PostgreSQL (trust auth).
# DB_PASSWORD=

# --- Django ---------------------------------------------------------------
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
